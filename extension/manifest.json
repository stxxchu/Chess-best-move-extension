{
  "manifest_version": 3,
  "name": "Chess Hints – move suggestions from your screen",
  "short_name": "Chess Hints",
  "version": "2.1.0",
  "description": "Finds the chessboard on your screen, reads the position and suggests moves at the level you pick, from the best to the worst. Stockfish runs locally.",
  "homepage_url": "https://github.com/stxxchu/Chess-best-move-extension",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chess Hints (Alt+Shift+C)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Show / hide the panel"
    },
    "scan-now": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Scan the board now"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
